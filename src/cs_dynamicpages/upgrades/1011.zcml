<configure xmlns="http://namespaces.zope.org/zope"
  xmlns:gs="http://namespaces.zope.org/genericsetup">

  <gs:registerProfile name="1011"
    title="Install new index and reindex"
    directory="1011"
    description='Configuration for version 1011'
    for="Products.CMFPlone.interfaces.IMigratingPloneSiteRoot"
    provides="Products.GenericSetup.interfaces.EXTENSION" />

  <gs:upgradeSteps source="1010"
    destination="1011"
    profile="cs_dynamicpages:default">

    <gs:upgradeStep title="Install new index and reindex"
      description=""
      handler=".v1011.upgrade" />

    <gs:upgradeDepends title="Install new index and reindex (GS profile)"
      description=""
      import_profile="cs_dynamicpages.upgrades:1011" />

  </gs:upgradeSteps>

</configure>
