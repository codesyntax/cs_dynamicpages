<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/prefs_main_template/macros/master"
      i18n:domain="cs_dynamicpages"
>
  <body>

    <div metal:fill-slot="prefs_configlet_main">

      <h1 class="documentFirstHeading"
          i18n:translate=""
      >Dynamic Pages Row Type Control Panel</h1>

      <p class="documentDescription"
         i18n:translate=""
      >
        This panel shows where each row type has been used through the site.
      </p>


      <div class="accordion"
           id="cs_dynamicpages-row-types-accordion"
      >
        <tal:row_type repeat="row_type view/row_types">
          <div class="accordion-item"
               tal:condition="row_type/count"
          >
            <h2 class="accordion-header">
              <button class="accordion-button collapsed"
                      aria-controls="collapse-${repeat/row_type/index}"
                      aria-expanded="false"
                      type="button"
                      data-bs-target="#collapse-${repeat/row_type/index}"
                      data-bs-toggle="collapse"
              >
                ${row_type/title}
              </button>
            </h2>
            <div class="accordion-collapse collapse"
                 id="collapse-${repeat/row_type/index}"
                 data-bs-parent="#cs_dynamicpages-row-types-accordion"
            >
              <div class="accordion-body">
                <ul>
                  <tal:item repeat="item row_type/used_in">
                    <li>
                      <a href="${item/absolute_url}">
                        ${item/title}
                      </a>
                      <tal:breadcrumbs condition="item/breadcrumbs">

                        <ul class="list-inline"
                            tal:define="
                              breadcrumbs item/breadcrumbs;
                            "
                        >
                          <span i18n:translate="">Location:</span>
                          <li class="list-inline-item"
                              tal:define="
                                navroot python:view.navroot(item.get('item'));
                              "
                          >
                            <a href="${navroot/absolute_url}">
                              ${navroot/Title}
                            </a>

                            <span>&nbsp;/</span>
                          </li>
                          <li class="list-inline-item"
                              tal:repeat="bread breadcrumbs"
                          >
                            <a href="${bread/absolute_url}">
                              ${bread/Title}
                            </a>

                            <span tal:condition="not:repeat/bread/end">&nbsp;/</span>
                          </li>
                        </ul>

                      </tal:breadcrumbs>
                    </li>
                  </tal:item>
                </ul>
              </div>
            </div>
          </div>
        </tal:row_type>

      </div>

    </div>

  </body>
</html>
